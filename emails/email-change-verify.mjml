<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-include path="./partials/afiax-head.mjml" />
    <mj-title>Confirm your new Afiax sign-in email</mj-title>
    <mj-preview>You now sign in to Afiax with this address. Please confirm it reaches you.</mj-preview>
  </mj-head>

  <mj-body background-color="#F1F5F9" width="600px">
    <mj-include path="./partials/afiax-header.mjml" />

    <mj-section background-color="#ffffff" padding="18px 32px 30px 32px">
      <mj-column>

        <mj-text mj-class="h1">Confirm your new sign-in email</mj-text>
        <mj-text>Hello{{#firstName}} {{firstName}}{{/firstName}},</mj-text>
        <mj-text>
          {{#changedByName}}{{changedByName}}, an administrator{{#projectName}} at {{projectName}}{{/projectName}},{{/changedByName}}{{^changedByName}}An administrator{{#projectName}} at {{projectName}}{{/projectName}}{{/changedByName}} changed the email address you use to sign in to Afiax. From now on you sign in with this address, <strong style="color:#1B2A4A;">{{newEmail}}</strong>.
        </mj-text>

        <mj-text padding="4px 0 22px 0">
          <table class="em-details" role="presentation" cellpadding="0" cellspacing="0">
            <tr><td class="k">New sign-in email</td><td class="v">{{newEmail}}</td></tr>
            <tr><td class="k">Previous email</td><td class="v">{{oldEmailMasked}}</td></tr>
            {{#changedByName}}<tr><td class="k">Changed by</td><td class="v">{{changedByName}}</td></tr>{{/changedByName}}
            <tr><td class="k" style="border-bottom:0;">Changed at</td><td class="v" style="border-bottom:0;">{{changedAt}}</td></tr>
          </table>
        </mj-text>

        <mj-text mj-class="h2">What to do</mj-text>
        <mj-text padding="0 0 4px 0">
          <strong style="color:#1B2A4A;">1. Confirm this address.</strong> This tells Afiax that emails sent here really reach you, including password-reset emails.
        </mj-text>
        <mj-button href="{{verifyUrl}}">Confirm my email</mj-button>
        <mj-text mj-class="small" padding="0 0 18px 0">
          If the button doesn't work, copy this link into your browser:<br /><span class="em-url">{{verifyUrl}}</span>
        </mj-text>
        <mj-text>
          <strong style="color:#1B2A4A;">2. Sign in with {{newEmail}}</strong> next time, at <a href="{{signInUrl}}">{{signInHost}}</a>. Your password and two-step sign-in stay the same.
        </mj-text>

        <mj-text mj-class="h2">What happens next</mj-text>
        <mj-text>
          Your previous address no longer works for signing in.{{#oldNotified}} We've sent a notice about this change to it too, in case the change wasn't expected.{{/oldNotified}} The confirmation link works once.
        </mj-text>

        <mj-text padding="8px 0 18px 0">
          <table class="em-help" role="presentation" cellpadding="0" cellspacing="0">
            <tr><td>
              <strong style="color:#1B2A4A;">Not you?</strong><br />
              If you don't have an Afiax account, this may have been sent to the wrong address. Don't confirm it. Tell Afiax support at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a> so the account can be corrected.
            </td></tr>
          </table>
        </mj-text>

      </mj-column>
    </mj-section>

    <mj-include path="./partials/afiax-footer.mjml" />
  </mj-body>
</mjml>
