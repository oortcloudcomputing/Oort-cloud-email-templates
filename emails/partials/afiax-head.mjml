<mjml>
  <mj-head>
    <!-- Light design only. Declaring "light" stops Apple Mail recolouring it; Gmail and Outlook
         apply their own dark mode, which this simple design survives. -->
    <mj-raw>
      <meta name="color-scheme" content="light" />
      <meta name="supported-color-schemes" content="light" />
    </mj-raw>
    <mj-font name="DM Sans" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="'DM Sans', Arial, Helvetica, sans-serif" />
      <mj-section padding="0" />
      <mj-text color="#334155" font-size="15px" line-height="1.6" padding="0 0 14px 0" />
      <mj-button background-color="#1B2A4A" color="#ffffff" border-radius="6px" font-size="15px" font-weight="700" inner-padding="13px 26px" padding="6px 0 10px 0" align="left" />
      <mj-divider border-color="#E2E8F0" border-width="1px" padding="10px 0 20px 0" />
      <mj-class name="h1" color="#1B2A4A" font-size="24px" line-height="1.3" font-weight="700" padding="0 0 14px 0" />
      <mj-class name="h2" color="#1B2A4A" font-size="16px" line-height="1.4" font-weight="700" padding="6px 0 8px 0" />
      <mj-class name="small" color="#64748B" font-size="13px" line-height="1.55" />
    </mj-attributes>
    <!-- Inlined at build time: mail goes out through our own SMTP relay, which does not inline CSS. -->
    <mj-style inline="inline">
      a { color: #00749C; }
      .em-details { width: 100%; border-collapse: collapse; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 6px; }
      .em-details td { padding: 8px 14px; font-size: 14px; line-height: 1.45; vertical-align: top; border-bottom: 1px solid #E2E8F0; }
      .em-details .k { color: #64748B; white-space: nowrap; width: 1%; padding-right: 18px; }
      .em-details .v { color: #1B2A4A; font-weight: 500; }
      .em-url { word-break: break-all; color: #64748B; }
      .em-help { width: 100%; border-collapse: collapse; background: #F0F9FF; border-left: 4px solid #00A9E0; }
      .em-help td { padding: 14px 16px; font-size: 14px; line-height: 1.55; color: #334155; }
    </mj-style>
  </mj-head>
</mjml>
