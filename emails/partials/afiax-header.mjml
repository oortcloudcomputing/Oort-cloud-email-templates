<!-- Brand bar and wordmark. Text, not an image, so it shows even when images are blocked. -->
<mj-section background-color="#00A9E0" padding="0">
  <mj-column>
    <mj-spacer height="4px" />
  </mj-column>
</mj-section>
<mj-section background-color="#ffffff" padding="26px 32px 6px 32px">
  <mj-column>
    <mj-text padding="0" font-size="22px" font-weight="700" color="#1B2A4A" line-height="1">
      Afiax<span style="color:#00A9E0;">.</span>
    </mj-text>
  </mj-column>
</mj-section>
